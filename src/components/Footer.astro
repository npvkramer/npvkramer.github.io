---
import { SITE } from '../data/site';

interface Props {
  /** Container-Klassen aus dem Layout, damit die Breite zum Inhalt passt. */
  class?: string;
}

const { class: containerClass } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class:list={[containerClass, 'site-footer-inner']}>
    <p>© {year} {SITE.author}</p>
    <ul class="footer-links">
      {SITE.social.map((link) => (
        <li>
          <a href={link.href} rel="me noopener">{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>
