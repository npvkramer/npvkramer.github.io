---
// A word styled as a dictionary entry. Used in the dictionary, on the word page and on the home page.
import type { HTMLAttributes } from 'astro/types';
import ExampleBadge from './ExampleBadge.astro';
import { isExample, wordUrl, type Word } from '../lib/content';

interface Props extends HTMLAttributes<'article'> {
  word: Word;
  size?: 'md' | 'lg';
  heading?: 'h1' | 'h2' | 'h3';
  /** Links the heading to the word's page. */
  link?: boolean;
}

const { word: entry, size = 'md', heading: Heading = 'h3', link = false, class: className, ...attrs } = Astro.props;
const { word, pronunciation, partOfSpeech, definition, origin } = entry.data;
---

<article class:list={['entry', `entry-${size}`, className]} {...attrs}>
  <div class="entry-head">
    <Heading class="headword">{link ? <a href={wordUrl(entry)}>{word}</a> : word}</Heading>
    {pronunciation && <span class="ipa">{pronunciation}</span>}
    {partOfSpeech && <span class="pos">{partOfSpeech}</span>}
    <ExampleBadge show={isExample(entry)} />
  </div>
  {definition && <p class="definition">{definition}</p>}
  {origin && <p class="origin">{origin}</p>}
  <slot />
</article>
