---
// One film or series: square image, title, rating, dates, type, seasons, genre, runtime, director or creator, studio, cast
// and description. Without an image (and without a placeholder image) the title's first letter is shown.
import { Image } from 'astro:assets';
import { filmImage, filmTitle, type Film } from '../lib/content';
import { getLocale, resolve, t } from '../i18n';

interface Props {
  film: Film;
}

// Rendered size in CSS comes from --film-image-size; this is the largest pixel size generated.
const IMAGE_PIXELS = 320;

const { film } = Astro.props;
const locale = getLocale(Astro.url);
const strings = t(locale).film;
const { releaseDate, endDate, seasons, type, director, creator, studio, cast, runtimeMinutes, rating } = film.data;
const makers = [(type === 'film' ? director : creator) ?? []].flat();
const { title, original } = filmTitle(film, locale);
const image = filmImage(film);
const genre = film.data.genre[locale];
const description = resolve(film.data.description, locale);
const ratingText = rating == null ? undefined : strings.rating(String(rating));
// Films: the full release date. Series: the years they ran (2018–2024), or “since 2018” while running.
// Dates are read in UTC so the day does not shift with the build machine's time zone.
const startYear = releaseDate.getUTCFullYear();
const endYear = endDate?.getUTCFullYear();
const dateText =
  type === 'film'
    ? new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(
        releaseDate,
      )
    : endYear === undefined
      ? strings.since(startYear)
      : endYear === startYear
        ? String(startYear)
        : `${startYear}–${endYear}`;
const meta = [strings.types[type], seasons && strings.seasons(seasons), genre, strings.runtime(runtimeMinutes)]
  .filter(Boolean)
  .join(' · ');
---

<article class="film" id={film.id}>
  {image ? (
    <Image class="film-image" src={image} alt="" width={IMAGE_PIXELS} height={IMAGE_PIXELS} fit="cover" />
  ) : (
    <span class="film-image film-monogram" aria-hidden="true">{title.charAt(0)}</span>
  )}
  <div class="film-body">
    <div class="film-head">
      <h3 class="film-title">{title}</h3>
      {ratingText && <span class="film-rating" aria-label={`${strings.ratingLabel}: ${ratingText}`}>{ratingText}</span>}
    </div>
    {original && <p class="film-original">{original}</p>}
    <p class="film-meta">
      <time datetime={releaseDate.toISOString().slice(0, 10)}>{dateText}</time>{` · ${meta}`}
    </p>
    {description && <p class="film-description" lang={description.lang}>{description.text}</p>}
    <dl class="film-credits">
      <div>
        <dt>{strings.makers[type]}</dt>
        <dd>{makers.join(', ')}</dd>
      </div>
      <div>
        <dt>{strings.studio}</dt>
        <dd>{studio.join(', ')}</dd>
      </div>
      <div>
        <dt>{strings.cast}</dt>
        <dd>{cast.join(', ')}</dd>
      </div>
    </dl>
  </div>
</article>
