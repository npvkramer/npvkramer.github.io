---
// Ein Zitat als Karte. Wörter aus `woerter` im Front Matter werden im Text verlinkt.
import { getEntries } from 'astro:content';
import ExampleBadge from './ExampleBadge.astro';
import { isExample, linkWords, type Quote } from '../lib/content';

interface Props {
  quote: Quote;
}

const { quote } = Astro.props;
const { autor, quelle, woerter } = quote.data;
const words = (await getEntries(woerter)).filter(Boolean);
const segments = linkWords((quote.body ?? '').trim(), words);
---

<figure class="quote-card">
  <blockquote class="quote-text">{segments.map((s) => (s.href ? <a class="word-link" href={s.href}>{s.text}</a> : s.text))}</blockquote>
  <figcaption class="quote-source">
    <span class="quote-author">{autor}</span>{quelle && `, ${quelle}`}
    <ExampleBadge show={isExample(quote)} />
  </figcaption>
</figure>
