---
// A quote as a card, like a film title: the quote in the page language first, the original below it.
// Without a translation into the page language (or when the quote already is in it) only the original shows.
// Words listed in `words` in the front matter are linked in the original, where they appear in that form.
import { getEntries } from 'astro:content';
import { linkWords, type Quote, type Word } from '../lib/content';
import { getLocale, languageName, resolve, resolveShared, t } from '../i18n';

interface Props {
  quote: Quote;
}

const { quote } = Astro.props;
const locale = getLocale(Astro.url);
const { lang, words: wordRefs } = quote.data;
const knownAuthor = resolveShared(quote.data.author, locale);
const author = knownAuthor ?? t(locale).resonance.unknownAuthor;
const source = resolve(quote.data.source, locale);
const translation = lang !== locale ? quote.data.translation?.[locale]?.trim() : undefined;
const words = (await getEntries(wordRefs)).filter((word): word is Word => Boolean(word));
const original = linkWords((quote.body ?? '').trim(), words, locale);
// The original is the main quote when there is no translation, otherwise the smaller line below it.
const Original = translation ? 'p' : 'blockquote';
// Values the sort switch on the Resonance page orders by (src/scripts/quote-sort.ts).
const sortText = (translation ?? quote.body ?? '').trim();
---

<figure
  class="quote-card"
  data-quote-card
  data-added={quote.data.added.toISOString().slice(0, 10)}
  data-quote={sortText}
  data-author={knownAuthor ?? ''}
>
  <div class="quote-body">
    {translation && <blockquote class="quote-text" lang={locale}>{translation}</blockquote>}
    <Original class={translation ? 'quote-original' : 'quote-text'} lang={lang}>{original.map((s) => (s.href ? <a class="word-link" href={s.href}>{s.text}</a> : s.text))}</Original>
  </div>
  <figcaption class="quote-source">
    <span class="quote-author">{author}</span>{source && <span lang={source.lang}>, {source.text}</span>}
    {lang !== locale && <span class="word-language">{` · ${languageName(lang, locale)}`}</span>}
  </figcaption>
</figure>
