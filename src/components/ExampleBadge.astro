---
// Marks example content (files in an `examples/` folder). Disappears together with the examples.
import { getLocale, t } from '../i18n';

interface Props {
  show: boolean;
}

const strings = t(getLocale(Astro.url)).entry;
---

{Astro.props.show && <span class="badge" title={strings.exampleTitle}>{strings.example}</span>}
