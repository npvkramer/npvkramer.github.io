---
// Word cloud: all words, scattered by src/scripts/word-cloud.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getWords, wordUrl, wordWeight } from '../lib/content';
import { hasLocale, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale).words;
const words = await getWords(locale);
---

<BaseLayout title={strings.title} description={strings.lead}>
  <PageHeader title={strings.title} lead={strings.lead} />

  <ul class="cloud" data-cloud>
    {words.map((word) => (
      <li>
        <a
          class="cloud-word"
          href={wordUrl(word, locale)}
          lang={word.data.lang}
          style={`--weight: ${wordWeight(word)}`}
          data-has-definition={hasLocale(word.data.definition, locale) ? '' : undefined}
        >
          {word.data.word}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<script src="../scripts/word-cloud.ts"></script>
