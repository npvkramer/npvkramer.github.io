---
// Film: films and series on one page, grouped by type. A filter shows one group, and a switch shows
// the entries as a list or as cards (square images that flip to show the details).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FilmEntry from '../components/FilmEntry.astro';
import { getFilms } from '../lib/content';
import { FILM_TYPES, type FilmType } from '../lib/film-types';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const VIEWS = ['list', 'cards'] as const;

const { locale } = Astro.props;
const strings = t(locale).film;
const films = await getFilms(locale);
const groups = FILM_TYPES.map((type) => ({ type, films: films.filter((film) => film.data.type === type) })).filter(
  (group) => group.films.length > 0,
);
// Anchor ids appear in the URL, so they follow the page language (#films, #serien).
const groupId = (type: FilmType) => strings.groups[type].toLowerCase();
---

<BaseLayout title={strings.title} description={strings.lead}>
  <PageHeader title={strings.title} lead={strings.lead} />

  {films.length === 0 && <p class="empty">{strings.none}</p>}

  {films.length > 0 && (
    <div class="list-controls">
      {groups.length > 1 && (
        <div class="filter-bar" role="group" aria-label={strings.filterLabel} data-film-filter hidden>
          <button class="button" type="button" data-filter="all" aria-pressed="true">{strings.all}</button>
          {groups.map(({ type }) => (
            <button class="button" type="button" data-filter={type} aria-pressed="false">{strings.groups[type]}</button>
          ))}
        </div>
      )}
      <div class="filter-bar" role="group" aria-label={strings.viewLabel} data-film-view-switch hidden>
        {VIEWS.map((view) => (
          <button class="button" type="button" data-view={view} aria-pressed={String(view === 'list')}>
            {strings.views[view]}
          </button>
        ))}
      </div>
    </div>
  )}

  <div class="films" data-films data-view="list">
    {groups.map(({ type, films }) => (
      <section class="film-group" id={groupId(type)} data-film-group={type}>
        <h2>{strings.groups[type]}</h2>
        <div class="film-list">
          {films.map((film) => <FilmEntry film={film} />)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<script src="../scripts/film-page.ts"></script>
