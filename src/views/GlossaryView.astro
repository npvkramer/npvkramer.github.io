---
// Glossary of a page language: words with a definition in that language, grouped A to Z.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import WordEntry from '../components/WordEntry.astro';
import { getGlossary, getQuotes, groupByLetter, quotesForWord, wordUrl } from '../lib/content';
import { resolve, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale).glossary;
const [words, quotes] = await Promise.all([getGlossary(locale), getQuotes()]);
const groups = groupByLetter(words);
// Anchor ids appear in the URL, so they follow the page language.
const letterId = (letter: string) => `${strings.letterAnchor}-${letter.toLowerCase()}`;
const searchText = (word: (typeof words)[number]) =>
  [word.data.word, word.data.romanization, resolve(word.data.definition, locale)?.text].join(' ').toLowerCase();
---

<BaseLayout title={strings.title} description={strings.lead}>
  <PageHeader title={strings.title} lead={strings.lead} />

  {groups.length === 0 ? (
    <p class="empty">{strings.none}</p>
  ) : (
    <div class="glossary-tools">
      <input
        class="search"
        type="search"
        placeholder={strings.search}
        aria-label={strings.searchLabel}
        autocomplete="off"
        data-glossary-search
        hidden
      />
      <nav class="letter-nav" aria-label={strings.index}>
        {groups.map(({ letter }) => <a href={`#${letterId(letter)}`}>{letter}</a>)}
      </nav>
    </div>
  )}

  {groups.map(({ letter, words }) => (
    <section class="letter-group" data-glossary-group>
      <h2 class="letter-head" id={letterId(letter)}>{letter}</h2>
      {words.map((word) => {
        const count = quotesForWord(quotes, word).length;
        return (
          <WordEntry word={word} link id={word.id} data-glossary-entry data-search={searchText(word)}>
            {count > 0 && (
              <p class="entry-refs">
                <a href={wordUrl(word, locale)}>{strings.inQuotes(count)}</a>
              </p>
            )}
          </WordEntry>
        );
      })}
    </section>
  ))}

  <p class="empty" data-glossary-empty hidden>{strings.empty}</p>
</BaseLayout>

<script src="../scripts/glossary-search.ts"></script>
