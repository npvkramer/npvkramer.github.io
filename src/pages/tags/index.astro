---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags } from '../../lib/posts';

const tags = getTags(await getPosts());
---

<BaseLayout title="Tags" description="Beiträge nach Thema.">
  <h1>Tags</h1>
  {tags.length === 0 ? (
    <p class="empty">Noch keine Tags.</p>
  ) : (
    <ul class="tag-list tag-list-large">
      {tags.map((tag) => (
        <li>
          <a class="tag" href={`/tags/${tag.slug}/`}>
            #{tag.name} <span class="count">{tag.count}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
