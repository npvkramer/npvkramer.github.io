---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import WordEntry from '../../components/WordEntry.astro';
import { getDictionary, getQuotes, groupByLetter, quotesForWord, wordUrl } from '../../lib/content';

const [words, quotes] = await Promise.all([getDictionary(), getQuotes()]);
const groups = groupByLetter(words);
const letterId = (letter: string) => `buchstabe-${letter.toLowerCase()}`;
---

<BaseLayout title="Wörterbuch" description="Wörter mit Lautschrift und Bedeutung, alphabetisch.">
  <PageHeader title="Wörterbuch" lead="Wörter mit Lautschrift und Bedeutung, alphabetisch." />

  <div class="dictionary-tools">
    <input
      class="search"
      type="search"
      placeholder="Wort oder Bedeutung suchen …"
      aria-label="Wörterbuch durchsuchen"
      autocomplete="off"
      data-dictionary-search
      hidden
    />
    <nav class="letter-nav" aria-label="Register">
      {groups.map(({ letter }) => <a href={`#${letterId(letter)}`}>{letter}</a>)}
    </nav>
  </div>

  {groups.map(({ letter, words }) => (
    <section class="letter-group" data-dictionary-group>
      <h2 class="letter-head" id={letterId(letter)}>{letter}</h2>
      {words.map((word) => {
        const count = quotesForWord(quotes, word).length;
        return (
          <WordEntry
            word={word}
            link
            id={word.id}
            data-dictionary-entry
            data-search={`${word.data.wort} ${word.data.definition}`.toLowerCase()}
          >
            {count > 0 && (
              <p class="entry-refs">
                <a href={wordUrl(word)}>Kommt in {count === 1 ? 'einem Zitat' : `${count} Zitaten`} vor</a>
              </p>
            )}
          </WordEntry>
        );
      })}
    </section>
  ))}

  <p class="empty" data-dictionary-empty hidden>Kein Eintrag gefunden.</p>
</BaseLayout>

<script src="../../scripts/dictionary-search.ts"></script>
