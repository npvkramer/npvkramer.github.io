---
// Every public page in every language. Paths come from the route table in src/i18n/routes.ts,
// so /glossary/inyeon/ (en) and /de/wortschatz/inyeon/ (de) render the same view.
import HomeView from '../views/HomeView.astro';
import WordView from '../views/WordView.astro';
import ResonanceView from '../views/ResonanceView.astro';
import GlossaryView from '../views/GlossaryView.astro';
import FilmView from '../views/FilmView.astro';
import { getWords, type Word } from '../lib/content';
import { LOCALES, pathTo, type Locale, type RouteKey } from '../i18n';

export async function getStaticPaths() {
  const words = await getWords('en');
  return LOCALES.flatMap((locale) => {
    const page = (route: RouteKey, word?: Word) => ({
      params: { route: pathTo(route, locale, word?.id).slice(1, -1) || undefined },
      props: { locale, route, word },
    });
    return [
      page('home'),
      page('resonance'),
      page('glossary'),
      page('film'),
      ...words.map((word) => page('glossary', word)),
    ];
  });
}

interface Props {
  locale: Locale;
  route: RouteKey;
  word?: Word;
}

const { locale, route, word } = Astro.props;
---

{route === 'home' && <HomeView locale={locale} />}
{route === 'resonance' && <ResonanceView locale={locale} />}
{route === 'glossary' && (word ? <WordView locale={locale} word={word} /> : <GlossaryView locale={locale} />)}
{route === 'film' && <FilmView locale={locale} />}
