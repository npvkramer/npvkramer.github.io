---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getWords, wordUrl, wordWeight } from '../../lib/content';

const words = await getWords();
const lead = 'Wörter, die ich mag. Ein Klick öffnet das Wort.';
---

<BaseLayout title="Wörter" description={lead}>
  <PageHeader title="Wörter" lead={lead} />

  <ul class="cloud" data-cloud>
    {words.map((word) => (
      <li>
        <a
          class="cloud-word"
          href={wordUrl(word)}
          style={`--weight: ${wordWeight(word)}`}
          data-has-definition={word.data.definition ? '' : undefined}
        >
          {word.data.word}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<script src="../../scripts/word-cloud.ts"></script>
