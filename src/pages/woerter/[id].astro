---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WordEntry from '../../components/WordEntry.astro';
import QuoteGrid from '../../components/QuoteGrid.astro';
import { getQuotes, getWords, quotesForWord, type Quote, type Word } from '../../lib/content';

export async function getStaticPaths() {
  const [words, quotes] = await Promise.all([getWords(), getQuotes()]);
  return words.map((word) => ({
    params: { id: word.id },
    props: { word, quotes: quotesForWord(quotes, word) },
  }));
}

interface Props {
  word: Word;
  quotes: Quote[];
}

const { word: entry, quotes } = Astro.props;
const { word, definition } = entry.data;
---

<BaseLayout title={word} description={definition ?? `${word} – aus meiner Wortsammlung.`}>
  <WordEntry word={entry} size="lg" heading="h1" />

  {quotes.length > 0 && (
    <section class="word-quotes">
      <h2>In Zitaten</h2>
      <QuoteGrid quotes={quotes} />
    </section>
  )}

  <p class="back">
    <a href="/woerter/">← Alle Wörter</a>
    {definition && <a href="/woerterbuch/">Wörterbuch</a>}
  </p>
</BaseLayout>
