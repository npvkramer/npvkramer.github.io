---
import BaseLayout from '../layouts/BaseLayout.astro';
import WordEntry from '../components/WordEntry.astro';
import { getDictionary, getQuotes, getWords } from '../lib/content';
import { countLabel } from '../lib/format';
import { SITE } from '../data/site';

const [words, dictionary, quotes] = await Promise.all([getWords(), getDictionary(), getQuotes()]);

const counts: Record<string, string> = {
  '/woerter/': countLabel(words.length, 'Wort', 'Wörter'),
  '/zitate/': countLabel(quotes.length, 'Zitat', 'Zitate'),
  '/woerterbuch/': countLabel(dictionary.length, 'Eintrag', 'Einträge'),
};
const areas = SITE.nav.filter((item) => 'description' in item);
---

<BaseLayout>
  <!-- Featured word: the first entry without JavaScript, otherwise a random one -->
  <section class="featured" data-random-pick>
    <p class="eyebrow">Wort des Moments</p>
    {dictionary.map((word, i) => (
      <WordEntry word={word} size="lg" heading="h2" link hidden={i > 0} data-random-item />
    ))}
    <button class="button" type="button" data-random-next hidden>Anderes Wort</button>
  </section>

  <ul class="area-list">
    {areas.map((area) => (
      <li>
        <a href={area.href}>
          <span class="area-title">{area.label}</span>
          <span class="area-description">{area.description}</span>
          <span class="area-count">{counts[area.href]}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<script src="../scripts/random-pick.ts"></script>
