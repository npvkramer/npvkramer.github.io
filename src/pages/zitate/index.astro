---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import QuoteGrid from '../../components/QuoteGrid.astro';
import { getQuotes } from '../../lib/content';

const quotes = await getQuotes();
const lead = 'Sätze und Sprüche, die mich bewegt haben. Unterstrichene Wörter stammen aus der Wortsammlung.';
---

<BaseLayout title="Zitate" description={lead} width="wide">
  <PageHeader title="Zitate" lead={lead} />
  <QuoteGrid quotes={quotes} />
</BaseLayout>
