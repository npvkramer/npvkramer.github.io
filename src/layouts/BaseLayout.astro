---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageHint from '../components/LanguageHint.astro';
import { SITE } from '../data/site';
import { DEFAULT_LOCALE, getLocale, languageLinks, parsePath, t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocale(Astro.url);
const { title, description = t(locale).siteDescription } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The same page in every language, for search engines. Only for pages in the route table.
const alternates = parsePath(Astro.url) ? languageLinks(Astro.url) : [];
const defaultAlternate = alternates.find((link) => link.locale === DEFAULT_LOCALE);
---

<!doctype html>
<html lang={locale} data-theme={SITE.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((link) => <link rel="alternate" hreflang={link.locale} href={new URL(link.href, Astro.site)} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.href, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <!-- Applies the saved light/dark choice before the first paint (prevents flashing). -->
    <script is:inline src="/scripts/theme-init.js"></script>
  </head>
  <body>
    <LanguageHint />
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
